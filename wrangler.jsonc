// Cloudflare Workers static-assets config (the new Pages). `npx wrangler deploy`
// uploads dist/ as static assets — no worker script, just the built site.
{
  "name": "woods-finance",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
